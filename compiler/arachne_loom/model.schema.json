{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arachne-loom.dev/schema/model-0.0.1.json",
  "title": "Reliable DOCX Canonical Model (provisional)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "language", "metadata", "resourceRoot", "blocks"],
  "properties": {
    "schemaVersion": {"const": "0.0.1-provisional"},
    "language": {"enum": ["zh-CN", "en-US"]},
    "metadata": {"type": "object"},
    "resourceRoot": {"type": "string"},
    "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
    "inline": {"oneOf": [
      {"type": "object", "required": ["type", "text"], "properties": {"type": {"const": "text"}, "text": {"type": "string"}}},
      {"type": "object", "required": ["type", "targetId"], "properties": {"type": {"const": "crossReference"}, "targetId": {"$ref": "#/$defs/id"}}},
      {"type": "object", "required": ["type", "targetId"], "properties": {"type": {"const": "literatureCitation"}, "targetId": {"$ref": "#/$defs/id"}}}
    ]},
    "block": {"oneOf": [
      {"type": "object", "required": ["type", "id", "level", "content", "numberPath"], "properties": {"type": {"const": "heading"}, "id": {"$ref": "#/$defs/id"}, "level": {"type": "integer", "minimum": 1, "maximum": 9}, "content": {"type": "string"}, "numberPath": {"type": "array", "items": {"type": "string"}}}},
      {"type": "object", "required": ["type", "inlines"], "properties": {"type": {"const": "paragraph"}, "inlines": {"type": "array", "items": {"$ref": "#/$defs/inline"}}}},
      {"type": "object", "required": ["type", "id", "title", "headerRows", "rows"], "properties": {"type": {"const": "table"}, "id": {"$ref": "#/$defs/id"}, "title": {"type": "string"}, "headerRows": {"const": 1}, "rows": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
      {"type": "object", "required": ["type", "id", "src", "title", "alt"], "properties": {"type": {"const": "figure"}, "id": {"$ref": "#/$defs/id"}, "src": {"type": "string"}, "title": {"type": "string"}, "alt": {"type": "string"}}},
      {"type": "object", "required": ["type", "kind", "items"], "properties": {"type": {"const": "list"}, "kind": {"enum": ["ordered", "unordered"]}, "start": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "items": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["inlines"], "properties": {"inlines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inline"}}}}}}},
      {"type": "object", "required": ["type", "items", "order"], "properties": {"type": {"const": "references"}, "order": {"enum": ["citationOrder"]}, "items": {"type": "array"}}}
    ]}
  }
}
