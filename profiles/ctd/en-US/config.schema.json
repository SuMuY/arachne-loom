{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arachne-loom.dev/schema/ctd-profile-0.0.1.json",
  "title": "CTD profile (provisional)",
  "type": "object",
  "required": ["configId", "page", "body", "styles", "caption", "capabilities"],
  "properties": {
    "configId": {"type": "string"},
    "page": {"type": "object"}, "body": {"type": "object"},
    "styles": {"type": "object", "required": ["roles"]},
    "headingStyle": {
      "type": "object",
      "properties": {
        "italic": {"type": "boolean"},
        "indentation": {
          "type": "object", "additionalProperties": false,
          "required": ["basePt", "incrementPt", "hangingPt"],
          "properties": {
            "basePt": {"type": "number", "minimum": 0},
            "incrementPt": {"type": "number", "minimum": 0},
            "hangingPt": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "captionStyle": {"type": "object"},
    "caption": {"type": "object", "required": ["table", "figure"]},
    "capabilities": {"type": "object", "required": ["literatureCitations"]}
  }
}
